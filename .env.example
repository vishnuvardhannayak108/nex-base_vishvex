# NexBase environment configuration (copy to .env and fill in real values).
# Every setting has a default in nexbase/config.py; only secrets are required.

# General
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Use the "Session pooler" URI from Project Settings > Database:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=
# A failed database write raises instead of being swallowed. Leave it on.
DB_STRICT=true

# ---------------------------------------------------------------------------
# Paid providers (used only on QUALIFIED companies)
# ---------------------------------------------------------------------------
# ZoomInfo: "username:private_key", or a pre-issued JWT.
ZOOMINFO_API_KEY=
ZOOMINFO_API_URL=https://api.zoominfo.com
APOLLO_API_KEY=
APOLLO_API_URL=https://api.apollo.io/api/v1
ZEROBOUNCE_API_KEY=
ZEROBOUNCE_API_URL=https://api.zerobounce.net/v2

# ---------------------------------------------------------------------------
# Freshness (hard cut at 14 days)
# ---------------------------------------------------------------------------
FRESHNESS_MAX_DAYS=14

# ---------------------------------------------------------------------------
# Qualification (<11 reject, 11-200 eligible, >200 reject, unknown -> review)
# ---------------------------------------------------------------------------
SIZE_FILTER_MIN=11
SIZE_FILTER_MAX=200
QUALIFY_THRESHOLD=50
INTERNAL_TA_REJECT_THRESHOLD=4
INTERNAL_TA_REVIEW_THRESHOLD=2
LINKEDIN_MAX_APPLICANTS=20

# ---------------------------------------------------------------------------
# Access layer
# ---------------------------------------------------------------------------
MAX_RETRIES=2
REQUEST_TIMEOUT_SECONDS=30
RATE_LIMIT_PER_SECOND=2.0
CAMOUFOX_BUDGET_PER_RUN=25

# ---------------------------------------------------------------------------
# USA-wide planner + source registry
# ---------------------------------------------------------------------------
# Titles searched per run, the user's job included.
PLANNER_MAX_TITLE_VARIANTS=5
# Portals switched off, comma-separated. List them: python -m nexbase.cli sources
SOURCES_DISABLED=
# Seconds between two calls to the same DIRECT/APIFY source.
SOURCE_MIN_INTERVAL_SECONDS=2.0
# Queries per source per run, state fan-out included.
SOURCE_MAX_CALLS_PER_RUN=60

# Apify (Glassdoor, ZipRecruiter). Paid per result: these sources stay off
# until a token is set, and each call is capped by items and dollars.
APIFY_API_TOKEN=
APIFY_MAX_CALLS_PER_RUN=5
APIFY_MAX_ITEMS_PER_QUERY=100
APIFY_MAX_CHARGE_USD_PER_CALL=1.0

# ATS slices are cached here, one file per dataset version (~430 MB for all).
# Keep it outside any synced folder.
ATS_CACHE_DIR=~/.cache/nexbase/ats
# The ats-scrapers full snapshot is ~16.9 GB. Leave this false.
ATS_ALLOW_FULL_SNAPSHOT=false

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Required in the X-API-Key header. Outside ENVIRONMENT=development an unset
# key makes every authenticated endpoint refuse to serve (503).
NEXBASE_API_KEY=
# Inbound requests per minute per caller.
NEXBASE_API_RATE_LIMIT=60
